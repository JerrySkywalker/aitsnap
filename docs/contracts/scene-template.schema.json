{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/JerrySkywalker/aitsnap/main/docs/contracts/scene-template.schema.json",
  "title": "CompositionScene v1",
  "description": "AITSnap v1 planning contract. Requires native implementation/acceptance before production use.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sceneId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "widthPx": {
          "type": "integer",
          "minimum": 1
        },
        "heightPx": {
          "type": "integer",
          "minimum": 1
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
        }
      },
      "required": [
        "widthPx",
        "heightPx",
        "background"
      ]
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "layerId": {
            "type": "string",
            "minLength": 1
          },
          "sourceRegionId": {
            "type": "string",
            "minLength": 1
          },
          "sourceArtifactId": {
            "type": "string",
            "minLength": 1
          },
          "zIndex": {
            "type": "integer",
            "minimum": -1000000
          },
          "visible": {
            "type": "boolean"
          },
          "locked": {
            "type": "boolean"
          },
          "sourceCropPx": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": -2147483648
              },
              {
                "type": "integer",
                "minimum": -2147483648
              },
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          },
          "destination": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number",
                "minimum": -1000000
              },
              "y": {
                "type": "number",
                "minimum": -1000000
              },
              "width": {
                "type": "number",
                "minimum": 0.001
              },
              "height": {
                "type": "number",
                "minimum": 0.001
              },
              "rotationDeg": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ]
          },
          "missingSourcePolicy": {
            "type": "string",
            "enum": [
              "fail",
              "placeholder",
              "skip"
            ]
          }
        },
        "required": [
          "layerId",
          "sourceRegionId",
          "zIndex",
          "visible",
          "destination",
          "missingSourcePolicy"
        ]
      },
      "minItems": 0
    },
    "revisionCreatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "sceneId",
    "revision",
    "name",
    "canvas",
    "layers"
  ]
}
