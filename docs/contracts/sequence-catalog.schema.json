{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/JerrySkywalker/aitsnap/main/docs/contracts/sequence-catalog.schema.json",
  "title": "SequenceCatalog v1",
  "description": "AITSnap v1 planning contract. Requires native implementation/acceptance before production use.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogId": {
      "type": "string",
      "minLength": 1
    },
    "catalogRevision": {
      "type": "string",
      "minLength": 1
    },
    "sourceSystem": {
      "type": "string",
      "minLength": 1
    },
    "importedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "sourceDigest": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "commandId": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "string",
                    "integer",
                    "number",
                    "boolean",
                    "enum"
                  ]
                },
                "unit": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "type"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "commandId",
          "name"
        ]
      },
      "minItems": 0
    },
    "sequences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sequenceId": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "stepId": {
                  "type": "string",
                  "minLength": 1
                },
                "order": {
                  "type": "integer",
                  "minimum": 0
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "command",
                    "subsequence",
                    "condition",
                    "loop",
                    "parallel"
                  ]
                },
                "commandId": {
                  "type": "string",
                  "minLength": 1
                },
                "subsequenceId": {
                  "type": "string",
                  "minLength": 1
                },
                "subsequenceRevision": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "metadata": {
                  "type": "object"
                }
              },
              "allOf": [
                { "if": { "properties": { "kind": { "const": "command" } }, "required": ["kind"] }, "then": { "required": ["commandId"] } },
                { "if": { "properties": { "kind": { "const": "subsequence" } }, "required": ["kind"] }, "then": { "required": ["subsequenceId", "subsequenceRevision"] } }
              ],
              "required": [
                "stepId",
                "order",
                "kind"
              ]
            },
            "minItems": 0
          }
        },
        "required": [
          "sequenceId",
          "revision",
          "name",
          "steps"
        ]
      },
      "minItems": 0
    },
    "extensions": {
      "type": "object"
    }
  },
  "required": [
    "schemaVersion",
    "catalogId",
    "catalogRevision",
    "sourceSystem",
    "importedAtUtc",
    "sourceDigest",
    "commands",
    "sequences"
  ]
}
